msgid "The value must be at least {min}."
msgstr "يجب أن تكون القيمة {min} على الأقل."

#: loomera/globalization/interactive_messages.py
msgid "The value must be no more than {max}."
msgstr "يجب ألا تتجاوز القيمة {max}."

